{
  "name": "northmes",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "check": "node scripts/check-node.mjs && turbo run lint typecheck && pnpm gen --check && vitest run --project unit --project integration --project web --project types",
    "check:full": "pnpm check && pnpm test:tz && pnpm e2e",
    "test:handoff": "pnpm check",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "gen": "node scripts/gen.mjs",
    "test": "vitest run --project unit --project integration --project web --project types",
    "test:coverage": "vitest run --coverage --project unit --project integration --project web --project types",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:ai": "vitest run --project ai",
    "test:tz": "TZ=Europe/Stockholm NM_TEST_PG_TZ=Europe/Stockholm vitest run --project unit --project integration",
    "lint:customer-data": "node scripts/lint/no-customer-data.mjs",
    "react-doctor": "react-doctor --yes --no-telemetry --no-supply-chain --blocking error --json --json-out react-doctor-report.json --project apps/web,modules/planning/web,packages/web-sdk",
    "react-doctor:summary": "node scripts/ci/react-doctor-summary.mjs react-doctor-report.json",
    "adr:next": "node scripts/adr/next-number.mjs",
    "northmes": "turbo run build --filter=@northmes/server --output-logs=errors-only && node apps/server/dist/main.js",
    "gen:migration": "node scripts/gen-migration.mjs",
    "plugin:build": "turbo run build --filter=@northmes/sdk --output-logs=errors-only && node scripts/plugin-build.mjs",
    "dev": "node scripts/stack/dev.mjs",
    "demo": "node scripts/stack/demo.mjs",
    "e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@northmes/contracts": "workspace:*",
    "@northmes/planning-contracts": "workspace:*",
    "@northmes/sdk": "workspace:*",
    "@northmes/server": "workspace:*",
    "@northmes/testing": "workspace:*",
    "@playwright/test": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "graphql": "catalog:",
    "happy-dom": "catalog:",
    "pg": "catalog:",
    "react-doctor": "catalog:",
    "rolldown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
