# The paths where a wrong merge is expensive or touches a security control (ADR 0086). A pull
# request that changes one of them, or renames a file out of one, is high risk: it merges only after
# the maintainer approves its head commit. Risk / risk gate reads this file from the default branch,
# so a pull request cannot change the paths that judge it.
#
# The patterns follow CODEOWNERS: a leading slash or a slash inside anchors a pattern at the root, a
# pattern with no slash matches at any depth, * stays within one folder, ** crosses folders, a
# pattern that names a folder covers everything below it, and one that ends in /* covers only the
# files directly in its folder. The gate refuses a pattern with whitespace, ! or [, so write an
# inline comment on a line of its own.

# Migrations, row-level security and database roles
**/migrations/**
/apps/backend/src/db/
/apps/backend/src/migrate/

# Authentication, permissions and access
/apps/backend/src/modules/core/infrastructure/auth/
/apps/backend/src/modules/core/api/access/
/apps/backend/src/modules/core/core/access/
/apps/backend/src/modules/*/permissions.ts
/apps/backend/src/principal.ts
/apps/backend/src/graphql/principal.ts
/apps/backend/src/graphql/limits.ts
/apps/backend/src/graphql/cost.ts
/apps/backend/src/graphql/server.ts
/apps/backend/src/graphql/yoga.driver.ts
/apps/backend/src/http/
/apps/backend/src/admin/
/apps/backend/src/boot/
/apps/backend/src/commands/command-bus.ts
/apps/web/src/auth/
/packages/sdk/src/commands/

# Secrets, configuration and deployment
/packages/sdk/src/config/
/packages/testing/src/credentials.ts
/deploy/
/Dockerfile
/infra/

# Plugins (signed archives, ADR 0075)
