# Copy this file to .env. Upgrading is changing NORTHMES_VERSION and running docker compose pull,
# down and up -d (ADR 0080). Each release's notes give the line to paste, pinned by its digest:
# NORTHMES_VERSION=0.0.1@sha256:<digest>
NORTHMES_VERSION=0.0.1

# The host name browsers use to reach NorthMES.
NORTHMES_HOST=localhost

# The address Caddy listens on. 0.0.0.0 is every address of the host; set one address, such as
# the host's address on the plant network, to listen there only.
NORTHMES_BIND_IP=0.0.0.0

# Nightly backups of the bundled db and the site's files to ./backups, kept 7 days (README.md,
# "Back up"). Copying them off the host is yours. Remove the line to turn the backups off.
COMPOSE_PROFILES=backup

# The most memory the app container may use. Raise it if docker compose ps shows app restarting.
# NORTHMES_APP_MEM_LIMIT=2g

# Rate limits of the REST API per integration token and minute, off by default (README.md, "API
# rate limits"). Turn them on and, if you need to, set the requests a token may send per minute:
# reads (GET) and writes (POST).
# NORTHMES_API_RATE_LIMIT=on
# NORTHMES_API_RATE_LIMIT_READS=600
# NORTHMES_API_RATE_LIMIT_WRITES=60

# Your own Postgres server instead of the bundled db (README.md, "Use your own Postgres"). The URL
# names the host, port and database, never a user or password. The admin's password goes in
# secrets/postgres_password. Your provider backs that server up, so the backup profile goes off;
# keep it on only for a portable dump of your own (README.md, "Back up").
# COMPOSE_PROFILES=
# COMPOSE_FILE=compose.yaml:compose.external-db.yaml
# NORTHMES_DATABASE_URL=postgres://pg.example.com:5432/northmes?sslmode=verify-full
# NORTHMES_DB_ADMIN_USER=northmes_admin
