{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!docs/sources",
      "!**/node_modules",
      "!**/dist",
      "!docs/agents/handoff/graphs",
      "!**/*.gen.ts",
      "!schema/*.graphql",
      "!test/meta/workspace.test.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended"
      },
      "style": {
        "noProcessEnv": "error"
      },
      "suspicious": {
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/ui/primitives/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noDoubleEquals": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**/*.graphql.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noConstantCondition": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/sdk/src/config/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test-d.ts",
        "**/test/**",
        "e2e/**",
        "scripts/**",
        "vitest.config.ts",
        "playwright.config.ts",
        "**/vite.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/backend/src/modules/*/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@nestjs/graphql": "A module's core/ holds domain services and command handlers and does not depend on GraphQL; put GraphQL types and resolvers in its api/ (ADR 0070)."
                },
                "patterns": [
                  {
                    "group": ["@nestjs/graphql/**"],
                    "message": "A module's core/ holds domain services and command handlers and does not depend on GraphQL; put GraphQL types and resolvers in its api/ (ADR 0070)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/backend/src/modules/*/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@northmes/sdk/data": "A module's api/ never touches the database; call a service in its core/ (ADR 0070).",
                  "kysely": "A module's api/ never touches the database; call a service in its core/ (ADR 0070).",
                  "pg": "A module's api/ never touches the database; call a service in its core/ (ADR 0070)."
                },
                "patterns": [
                  {
                    "group": [
                      "**/infrastructure/**",
                      "**/db/**",
                      "@northmes/sdk/data/**",
                      "kysely/**",
                      "pg/**"
                    ],
                    "message": "A module's api/ never touches the database; call a service in its core/ (ADR 0070)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
