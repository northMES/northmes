{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!docs/sources",
      "!**/node_modules",
      "!**/dist",
      "!docs/agents/handoff/graphs",
      "!test/meta/workspace.test.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended"
      },
      "style": {
        "noProcessEnv": "error"
      },
      "suspicious": {
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/sdk/src/config/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test-d.ts",
        "**/test/**",
        "e2e/**",
        "scripts/**",
        "vitest.config.ts",
        "playwright.config.ts",
        "**/vite.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
